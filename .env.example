# LDAP Configuration
# Servidor LDAP (IP o hostname)
LDAP_SERVER=servidor-ad.empresa.local

# Puerto LDAP (389 para LDAP sin cifrar, 636 para LDAPS con SSL)
LDAP_PORT=389

# Dominio para autenticación directa (username@domain)
LDAP_DOMAIN=empresa.local

# Usar SSL/TLS (True para LDAPS puerto 636, False para LDAP puerto 389)
# RECOMENDADO: True en producción para comunicación cifrada
LDAP_USE_SSL=False

# Base DN del directorio LDAP
# Ejemplo: DC=example,DC=com
LDAP_BASE_DN=DC=empresa,DC=local

# Base DN donde buscar usuarios
# Ejemplo: OU=Users,DC=example,DC=com
# Si quieres buscar en todo el dominio, usa el mismo valor que LDAP_BASE_DN
LDAP_USER_SEARCH_BASE=DC=empresa,DC=local

# Filtro LDAP para búsqueda de usuarios activos (no deshabilitados)
# {username} será reemplazado por el username ingresado en el login
# Este filtro excluye cuentas deshabilitadas usando userAccountControl:1.2.840.113556.1.4.803:=2
LDAP_USER_SEARCH_FILTER=(&(&(objectClass=user)(objectCategory=person))(!(userAccountControl:1.2.840.113556.1.4.803:=2))(sAMAccountName={username}))

# Microsoft Graph Configuration
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Certificado para SharePoint REST API (REQUERIDO para adjuntos en listas)
# Genera el certificado con: ./generate-certificate.sh
GRAPH_CERTIFICATE_PATH=./sharepoint-app-cert.pfx
GRAPH_CERTIFICATE_THUMBPRINT=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SharePoint Configuration
SP_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SP_LIST_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Next Auth Secret (genera uno con: openssl rand -base64 32)
NEXTAUTH_SECRET=una_clave_segura_generada_aleatoriamente

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Oracle Database Configuration
ORACLE_USER=nombre_usuario
ORACLE_PASSWORD=contraseña_segura
ORACLE_CONNECTION_STRING=hostname:puerto/nombre_servicio
# Ejemplo: ORACLE_CONNECTION_STRING=192.168.1.100:1521/ORCL

# AD Groups Configuration
# Configuración de grupos de Active Directory para control de acceso
# Los nombres deben coincidir EXACTAMENTE con los grupos en AD (case-insensitive)

# Grupos para acceso a módulo "Notificaciones de Cobranzas" (separados por coma)
# Usuarios que pertenezcan a cualquiera de estos grupos tendrán acceso
AD_GROUP_COBRANZAS=cobranza,Tecnologia

# Grupos para acceso a módulo "Inspecciones de Crédito" (separados por coma)
# Usuarios que pertenezcan a cualquiera de estos grupos tendrán acceso
AD_GROUP_INSPECCIONES=oficialesnegocios,jefeagencia

# NOTA IMPORTANTE:
# - Los usuarios deben pertenecer AL MENOS a uno de los grupos configurados arriba
# - Si un usuario no pertenece a ningún grupo permitido, no podrá iniciar sesión
# - Los nombres de grupos NO distinguen mayúsculas/minúsculas
# - Puedes agregar o quitar grupos separándolos con comas
